[Unit]
Description=michaelkarpeles.com / mek.fyi (FastAPI via uvicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/michaelkarpeles.com
ExecStart=/srv/michaelkarpeles.com/.venv/bin/uvicorn mekarpeles.asgi:app --host 127.0.0.1 --port 8090 --workers 2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
